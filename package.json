{
	"name": "@rbxts/allocator",
	"version": "1.1.2",
	"description": "Roblox-TS object pooling system with configurable allocation strategies for efficient object management.",
	"keywords": [
		"roblox",
		"roblox-ts",
		"rbxts",
		"object-pool",
		"pooling",
		"allocation",
		"memory-management",
		"performance"
	],
	"homepage": "https://github.com/Velover/allocator-package-rbxts#readme",
	"bugs": {
		"url": "https://github.com/Velover/allocator-package-rbxts/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Velover/allocator-package-rbxts.git"
	},
	"license": "MIT",
	"author": "Catargo",
	"type": "commonjs",
	"main": "out/init.lua",
	"types": "out/index.d.ts",
	"files": [
